# SQLite-Datei. Lokal relativ zum cms-Ordner, beim Hosting auf dem persistenten Volume,
# z. B. file:/data/tripnjungle.db
DATABASE_URI=file:./tripnjungle.db

# Ordner für hochgeladene Bilder/Videos. Lokal "media", beim Hosting z. B. /data/media
MEDIA_DIR=media

# Langer, zufälliger String (z. B. openssl rand -hex 32). Niemals weitergeben.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende. Daraus entstehen
# Canonical-URLs, Sitemap und Open-Graph-Links. Lokal: http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
